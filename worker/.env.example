# Reference for the bindings this Worker reads. Real values belong in Worker
# secrets/vars, never in a committed file.
#
# There is no client credential: the Worker is an open endpoint and callers need
# nothing but a base URL plus their own upstream Authorization header.
# EGRESS_RELAY_SECRET authenticates the WORKER to the relay only, and every
# client-supplied x-codex-relay-* header is stripped so a caller cannot forge a
# signed relay envelope with it.

# --- Upstream allowlist (plain var, optional but strongly advised) -----------
#
# Comma-separated hostnames this Worker may reach. Matched case-insensitively
# against the exact host; a leading dot also matches subdomains and the parent.
# Unset or empty allows ANY public HTTPS host, which makes this an open proxy
# egressing from the relay's address -- set it for any shared deployment.
#
#   ALLOWED_UPSTREAM_HOSTS=ps.air-outer.com,.openai.com

# --- Relay egress (required; the relay is the only egress path) -------------
#
# URL and key id are not secret and live in wrangler.toml so a deploy cannot
# silently lose them. The signing secret is a Worker secret.
#
# EGRESS_RELAY_URL must be an absolute https:// URL ending in /v1/forward.
#
# EGRESS_RELAY_URL=https://relay.example.com/v1/forward
# EGRESS_RELAY_KEY_ID=key-1
#   wrangler secret put EGRESS_RELAY_SECRET
#
# Any missing or malformed value fails the request with 502 relay_unavailable.
# There is no direct-egress fallback: falling back would leak the client's
# traffic out of Cloudflare's address space, which is what the relay exists to
# prevent.

# --- Optional identity / limit bindings ------------------------------------
#
# CODEX_PROXY_UA_VERSION=0.145.0
# CODEX_PROXY_ORIGINATOR=codex-tui
# CODEX_PROXY_UA_OS=Debian 12.0.0; x86_64
# CODEX_PROXY_UA_TERMINAL=unknown
# CODEX_PROXY_USER_AGENT=
# CODEX_PROXY_BETA_FEATURES=remote_compaction_v2
# CODEX_PROXY_INSTALLATION_ID=
# CODEX_PROXY_ACCEPT_ENCODING=gzip, deflate
# CODEX_PROXY_MAX_BODY_BYTES=10485760
