# Direct mode: leave EGRESS_PROXY_URL unset.
#
# Proxy mode: SOCKS5 only. The Worker negotiates SOCKS5, authenticates with
# RFC 1929 when the URL carries credentials, issues CONNECT with ATYP=DOMAIN,
# then starts TLS against the upstream hostname.
#
# socks5h is accepted as an alias for socks5: CONNECT always sends the upstream
# as a domain name, so the proxy resolves it and no DNS lookup happens locally.
#
# EGRESS_PROXY_URL=socks5://proxy.example:1080
# EGRESS_PROXY_URL=socks5://user:pass@proxy.example:1080
#
# Any other scheme (including http://) is rejected: the Worker fails closed with
# 502 proxy_unavailable and never falls back to direct egress.
#
# Percent-encode credentials that contain @ : / characters.
#
# The URL contains credentials, so set it as a Worker Secret, never in
# wrangler.toml or a committed .env file:
# wrangler secret put EGRESS_PROXY_URL
#
# Optional setup deadline for handshake + TLS + response head (default 120000 ms).
# It deliberately does not bound the response body, so SSE streams can idle.
# CODEX_PROXY_TUNNEL_TIMEOUT_MS=120000
